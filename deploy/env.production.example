# /opt/artai/.env на сервере. В репозиторий не попадает.
# Заполняется один раз при подготовке сервера, дальше деплой его не трогает.

# --- база (пароль придумайте длинный, он же уходит в DATABASE_URL) ---
POSTGRES_USER=artai
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ
POSTGRES_DB=artai
DATABASE_URL=postgresql+asyncpg://artai:ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ@postgres:5432/artai

# --- provod.ai ---
PROVOD_API_KEY=sk_ЗАМЕНИТЕ
PROVOD_BASE_URL=https://api.provod.ai/v1
PROVOD_IMAGE_MODEL=openai/gpt-image-2
PROVOD_TEXT_MODEL=google/gemini-3.1-flash-lite

# --- купольный экран ---
DOME_TOKEN=ЗАМЕНИТЕ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ
TERMINAL_ID=terminal-1

# --- приложение ---
STORAGE_DIR=/app/storage
CODE_GENERATIONS_LIMIT=10
IMAGE_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=10
AUTO_MIGRATE=true
CORS_ORIGINS=

# Образ подставляет деплой; вручную менять нужно только для отката на конкретный тег.
APP_IMAGE=ghcr.io/fouregg/artaiproject:latest
