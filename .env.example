# --- provod.ai gateway ---
# Ключ живёт ТОЛЬКО здесь. Никогда не попадает во фронтенд и в git.
PROVOD_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PROVOD_BASE_URL=https://api.provod.ai/v1
PROVOD_IMAGE_MODEL=openai/gpt-image-2
PROVOD_TEXT_MODEL=google/gemini-3.1-flash-lite

# --- database ---
DATABASE_URL=postgresql+asyncpg://artai:artai@localhost:5433/artai

# --- dome screen ---
# Токен, с которым купольный экран подключается к /dome и /ws/dome
DOME_TOKEN=change-me-to-a-long-random-string

# Идентификатор киоска, попадает в запись акцепта
# Токен модерации холста: страница /admin?token=...
ADMIN_TOKEN=change-me-to-another-long-random-string
TERMINAL_ID=terminal-1

# --- app ---
STORAGE_DIR=storage
# Сколько генераций даёт один код доступа
CODE_GENERATIONS_LIMIT=10
# Незакреплённая картинка (не на куполе и не в галерее) удаляется через столько минут
IMAGE_TTL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=10
AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:5173
